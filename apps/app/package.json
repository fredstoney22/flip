{
	"name": "@flip/app",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint src tests",
		"lint:fix": "eslint src tests --fix",
		"test": "playwright test",
		"test:ui": "playwright test --ui",
		"test:color-venn": "REVIEW_VENN=1 playwright test --config playwright.dev.config.ts tests/color-venn-diagram.test.ts",
		"test:puzzle-shell": "REVIEW_PUZZLE_SHELL=1 playwright test --config playwright.dev.config.ts tests/puzzle-shell.stories.test.ts",
		"test:color-square": "REVIEW_COLOR_SQUARE=1 playwright test --config playwright.dev.config.ts tests/color-square.stories.test.ts",
		"test:report": "playwright show-report"
	},
	"dependencies": {
		"@flip/api": "*",
		"@flip/auth": "*",
		"@flip/game": "*",
		"@inlang/paraglide-js": "^2.20.2",
		"@sentry/sveltekit": "^10.58.0",
		"better-auth": "^1.4.0",
		"stripe": "^20.3.1",
		"svelte-sonner": "^1.0.7"
	},
	"devDependencies": {
		"@eslint/js": "^9.28.0",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-vercel": "^6.3.1",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/pngjs": "^6.0.5",
		"eslint": "^9.28.0",
		"eslint-plugin-svelte": "^2.46.0",
		"globals": "^16.0.0",
		"pngjs": "^7.0.0",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.1.18",
		"typescript-eslint": "^8.29.0",
		"vite": "^7.3.1",
		"zod": "^4.3.6"
	}
}
